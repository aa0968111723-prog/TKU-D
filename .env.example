# Session signing. Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# development | production
NODE_ENV=development

# Allow the labeled development login. Off in production unless you set this true.
# Self-hosted lab use before TKU grants an OIDC client: set true and keep the host private.
AUTH_DEV_LOGIN=

# Public origin, no trailing slash. Used for OAuth redirects.
APP_ORIGIN=http://localhost:3000

# SQLite + uploads. Defaults to ./data
DATA_DIR=./data

# AI. Default is the local Hermes proxy, which attaches xAI Grok OAuth.
# Start it with: npm run ai-proxy
AI_PROVIDER=hermes-proxy
AI_BASE_URL=http://127.0.0.1:8645/v1
AI_API_KEY=local
AI_FAST_MODEL=grok-4.20-non-reasoning
AI_REASONING_MODEL=grok-4.20-reasoning

# Optional direct xAI key. Used only when AI_PROVIDER=xai-api.
# XAI_API_KEY=

# Optional OpenAI-compatible endpoint. Used when AI_PROVIDER=openai-compatible.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Google OAuth. Leave empty until you create a client.
# Redirect URI: {APP_ORIGIN}/api/auth/google/callback
# Scopes requested: openid email profile, Drive readonly, Calendar readonly, Gmail readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend, for magic-link email login. If empty, development prints the link in the server log only.
RESEND_API_KEY=
EMAIL_FROM=

# TKU SSO. Do not invent these. The public sso.tku.edu.tw endpoint is IBM WebSEAL
# and does not publish a third-party OIDC client. Fill only after the university
# grants a real issuer, client id, and secret.
TKU_OIDC_ISSUER=
TKU_OIDC_CLIENT_ID=
TKU_OIDC_CLIENT_SECRET=
TKU_OIDC_SCOPES=openid email profile

# Optional Zotero. Users can also paste a key in Settings; this is the server default.
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# Crossref polite pool
CROSSREF_MAILTO=
# Browserbase cloud browser. Project is inferred from the key. Do not commit the real value.
BROWSERBASE_API_KEY=
